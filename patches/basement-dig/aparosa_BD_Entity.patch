+local function completeExpansion(character, x, y, z, tier, half, plan)
+    local canSpoil, whySpoil = aparosa_BD_Spoil.canExpand(character)
+    if not canSpoil then
+        -- カーソルでは見ているので、ここへ来るのは建てる間に袋を手放した時だけ
+        log("entity: expand refused " .. tostring(whySpoil))
+        aparosa_BD_Check.notifyFailure(character, whySpoil)
+        return false
+    elseif not aparosa_BD_Entity.asBuilder(character, aparosa_BD_Expand.apply, x, y, z, tier, nil, nil, plan) then
+        log("entity: expand failed")
+        aparosa_BD_Check.notifyFailure(character, nil)
+        return false
+    elseif not (aparosa_BD_Types.tier(tier) and aparosa_BD_Types.tier(tier).cost) then
+        -- 材料を取らない等級（土の壁）は返す物も無い（aparosa_BD_Types.registerTier の cost が nil）
+        aparosa_BD_Spoil.onExpanded(character)
+        aparosa_BD_Sync.publish()
+    else
+        aparosa_BD_Spoil.onExpanded(character)
+        local walls = aparosa_BD_Expand.wallsBuiltAround(x, y, z)
+        local refund = aparosa_BD_Expand.refundFor(aparosa_BD_Types.tier(tier).cost, half == true, walls,
+            aparosa_BD_Sandbox.materialFactor())
+        aparosa_BD_Expand.giveRefund(character, refund)
+        local parts = {}
+        for item, n in pairs(refund) do table.insert(parts, item .. "=" .. n) end
+        log(string.format("expand refund walls=%d half=%s %s", walls, tostring(half == true), table.concat(parts, " ")))
+        aparosa_BD_Sync.publish()
+    end
+    return true
 end
 
