+local function transmitSnapshot()
+    local start = getTimestampMs()
+    ModData.transmit(KEY)
+    local elapsed = getTimestampMs() - start
+    if elapsed >= 100 then
+        print(string.format("[BasementDig] slow snapshot transmitMs=%d", elapsed))
+    end
+end
+
+-- 記録の写しを地下室のマスへも置く（落ちた時に記録だけが消えるのを戻すため。aparosa_BD_Mirror、todo B33）
+local function writeRecovery(changedRecord)
+    if aparosa_BD_Mirror then
+        aparosa_BD_Mirror.sync(changedRecord)
+    end
+end
+
+function aparosa_BD_Sync.publish(changedRecord)
     if isServer() then
-        ModData.transmit(KEY)
-    end
-    -- 記録の写しを地下室のマスへも置く（落ちた時に記録だけが消えるのを戻すため。aparosa_BD_Mirror、todo B33）
-    if aparosa_BD_Mirror then
-        aparosa_BD_Mirror.sync()
+        -- An immediate full snapshot already includes any previously completed adoption.
+        if library then library.Coalesce.cancel(SNAPSHOT, OWNER) end
+        transmitSnapshot()
+    end
+    writeRecovery(changedRecord)
+end
+
+local function isSavedRecord(record)
+    for _, current in ipairs(aparosa_BD_Rooms.saved()) do
+        if current == record then return true end
+    end
+    return false
+end
+
+function aparosa_BD_Sync.publishAdoption(record, recheckRecord)
+    if not library then
+        return aparosa_BD_Sync.publish(record)
+    end
+    -- The world change and recovery copies complete before the snapshot becomes eligible.
+    -- Other BasementDig entry points can change saved records while this job waits.
+    -- A removed record must not be recreated in square recovery data.
+    if not recheckRecord or isSavedRecord(record) then
+        writeRecovery(record)
+    end
+    local ticket = library.Coalesce.latest(SNAPSHOT, transmitSnapshot, 500, OWNER)
+    if not ticket then
