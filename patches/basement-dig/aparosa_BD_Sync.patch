-function aparosa_BD_Sync.publish()
+local OWNER = "aparosa_BasementDig"
+local SNAPSHOT = "basement-records"
+local library
+
+function aparosa_BD_Sync.deferredLibrary()
+    if isServer() and getActivatedMods():contains("apocalipsebr_bplib") then
+        local candidate = library or require "ApocalipseBR_BPLib"
+        if candidate and candidate.Jobs and candidate.Jobs.checkpoint
