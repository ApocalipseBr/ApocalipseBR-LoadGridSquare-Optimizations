+-- A pending step keeps the same ticket. The completion callback owns all world writes.
+function aparosa_BD_Expand.newJob(x, y, z, complete)
+    local plan, nextRecord = nil, 0
+    local searchMs, geometryMs, pauses = 0, 0, 0
+    local function pause()
+        pauses = pauses + 1
+        return false
+    end
+    return function(_, checkpoint)
+        local start = getTimestampMs()
+        if nextRecord == 0 then
+            if not aparosa_BD_Expand.touchesMap(x, y, z) then
+                local record, others = aparosa_BD_Expand.withFrozenIndex(expansionRecords, x, y, z)
+                if record then
+                    plan = { index = index.byKey, record = record, others = others, tiles = {} }
+                end
+            end
+            nextRecord = 1
+            searchMs = getTimestampMs() - start
+            if checkpoint() then return pause() end
+        elseif plan and not plan.diff then
+            -- Other world callbacks can change saved records while the ticket is paused.
+            if recordIndex() ~= plan.index then plan = nil end
+            searchMs = searchMs + getTimestampMs() - start
+            if not plan and checkpoint() then return pause() end
+        end
+
+        if plan and not plan.diff then
+            start = getTimestampMs()
+            while nextRecord <= #plan.others + 1 do
+                local record = nextRecord == 1 and plan.record or plan.others[nextRecord - 1]
+                appendTiles(plan.tiles, record)
+                nextRecord = nextRecord + 1
+                if checkpoint() then
+                    geometryMs = geometryMs + getTimestampMs() - start
+                    return pause()
+                end
+            end
+            plan.diff = aparosa_BD_Layout.expandDiff(plan.tiles, { x = x, y = y })
+            geometryMs = geometryMs + getTimestampMs() - start
+            if checkpoint() then return pause() end
+        end
+
+        start = getTimestampMs()
+        local result = complete(plan)
+        local finishMs = getTimestampMs() - start
+        if searchMs + geometryMs + finishMs >= 100 then
+            print(string.format("[BasementDig] slow expand x=%d y=%d z=%d searchMs=%d"
+                .. " geometryMs=%d finishMs=%d pauses=%d result=%s",
+                x, y, z, searchMs, geometryMs, finishMs, pauses, tostring(result)))
+        end
+        return true
+    end
+end
+
 return aparosa_BD_Expand
